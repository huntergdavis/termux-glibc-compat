diff --git a/sysdeps/unix/sysv/linux/semget.c b/sysdeps/unix/sysv/linux/semget.c
--- a/sysdeps/unix/sysv/linux/semget.c
+++ b/sysdeps/unix/sysv/linux/semget.c
@@ -21,6 +21,7 @@
 #include <sysdep.h>
 #include <errno.h>
 #include <fakesyscall.h>
+#include <tgcompat/glibc.h>
 
 /* Return identifier for array of NSEMS semaphores associated with
    KEY.  */
@@ -28,9 +29,5 @@
 int
 semget (key_t key, int nsems, int semflg)
 {
-#ifdef __ASSUME_DIRECT_SYSVIPC_SYSCALLS
-  return syscall (__NR_semget, key, nsems, semflg);
-#else
-  return INLINE_SYSCALL_CALL (ipc, IPCOP_semget, key, nsems, semflg, NULL);
-#endif
+  return __tgcompat_glibc_semget (key, nsems, semflg);
 }
diff --git a/sysdeps/unix/sysv/linux/semtimedop.c b/sysdeps/unix/sysv/linux/semtimedop.c
--- a/sysdeps/unix/sysv/linux/semtimedop.c
+++ b/sysdeps/unix/sysv/linux/semtimedop.c
@@ -20,20 +20,7 @@
 #include <sysdep.h>
 #include <errno.h>
 #include <fakesyscall.h>
-
-static int
-semtimedop_syscall (int semid, struct sembuf *sops, size_t nsops,
-		    const struct __timespec64 *timeout)
-{
-#ifdef __NR_semtimedop_time64
-  return syscall (__NR_semtimedop_time64, semid, sops, nsops, timeout);
-#elif defined __ASSUME_DIRECT_SYSVIPC_SYSCALLS && defined __NR_semtimedop
-  return syscall (__NR_semtimedop, semid, sops, nsops, timeout);
-#else
-  return INLINE_SYSCALL_CALL (ipc, IPCOP_semtimedop, semid,
-			      SEMTIMEDOP_IPC_ARGS (nsops, sops, timeout));
-#endif
-}
+#include <tgcompat/glibc.h>
 
 /* Perform user-defined atomic operation of array of semaphores.  */
 int
@@ -40,32 +27,10 @@
 __semtimedop64 (int semid, struct sembuf *sops, size_t nsops,
 		const struct __timespec64 *timeout)
 {
-#ifdef __ASSUME_TIME64_SYSCALLS
-  return semtimedop_syscall (semid, sops, nsops, timeout);
-#else
-  bool need_time64 = timeout != NULL && !in_int32_t_range (timeout->tv_sec);
-  if (need_time64)
-    {
-      int r = semtimedop_syscall (semid, sops, nsops, timeout);
-      if (r == 0 || errno != ENOSYS)
-	return r;
-      __set_errno (EOVERFLOW);
-      return -1;
-    }
-
-  struct timespec ts32, *pts32 = NULL;
-  if (timeout != NULL)
-    {
-      ts32 = valid_timespec64_to_timespec (*timeout);
-      pts32 = &ts32;
-    }
-# ifdef __ASSUME_DIRECT_SYSVIPC_SYSCALLS
-  return syscall (__NR_semtimedop, semid, sops, nsops, pts32);
-# else
-  return INLINE_SYSCALL_CALL (ipc, IPCOP_semtimedop, semid,
-			      SEMTIMEDOP_IPC_ARGS (nsops, sops, pts32));
-# endif
-#endif
+  return __tgcompat_glibc_semtimedop (
+      semid, sops, nsops, timeout != NULL,
+      timeout != NULL ? timeout->tv_sec : 0,
+      timeout != NULL ? timeout->tv_nsec : 0);
 }
 #if __TIMESIZE != 64
 libc_hidden_def (__semtimedop64)
diff --git a/sysdeps/unix/sysv/linux/semctl.c b/sysdeps/unix/sysv/linux/semctl.c
--- a/sysdeps/unix/sysv/linux/semctl.c
+++ b/sysdeps/unix/sysv/linux/semctl.c
@@ -23,6 +23,8 @@
 #include <shlib-compat.h>
 #include <linux/posix_types.h>             /* For __kernel_mode_t.  */
 #include <fakesyscall.h>
+#include <string.h>
+#include <tgcompat/glibc.h>
 
 /* The struct used to issue the syscall.  For architectures that assume
    64-bit time as default (!__ASSUME_TIME64_SYSCALLS) the syscall will
@@ -121,13 +123,125 @@
 static int
 semctl_syscall (int semid, int semnum, int cmd, semctl_arg_t arg)
 {
-#ifdef __ASSUME_DIRECT_SYSVIPC_SYSCALLS
-  return syscall (__NR_semctl, semid, semnum, cmd | __IPC_64,
-			      arg.array);
-#else
-  return INLINE_SYSCALL_CALL (ipc, IPCOP_semctl, semid, semnum, cmd | __IPC_64,
-			      SEMCTL_ARG_ADDRESS (arg));
-#endif
+  switch (cmd)
+    {
+    case IPC_RMID:
+      return __tgcompat_glibc_remove (semid);
+    case GETVAL:
+      return __tgcompat_glibc_getval (semid, semnum);
+    case SETVAL:
+      return __tgcompat_glibc_setval (semid, semnum, arg.val);
+    case GETPID:
+      return __tgcompat_glibc_getpid (semid, semnum);
+    case GETNCNT:
+      return __tgcompat_glibc_getncnt (semid, semnum);
+    case GETZCNT:
+      return __tgcompat_glibc_getzcnt (semid, semnum);
+    case GETALL:
+      return __tgcompat_glibc_getall (semid, arg.array);
+    case SETALL:
+      return __tgcompat_glibc_setall (semid, arg.array);
+    case IPC_SET:
+      if (arg.buf == NULL)
+	{
+	  __set_errno (EFAULT);
+	  return -1;
+	}
+      return __tgcompat_glibc_set_metadata (
+          semid, arg.buf->sem_perm.uid, arg.buf->sem_perm.gid,
+          arg.buf->sem_perm.mode & 0777U);
+    case IPC_STAT:
+      {
+	if (arg.buf == NULL)
+	  {
+	    __set_errno (EFAULT);
+	    return -1;
+	  }
+	struct tgc_sem_metadata metadata;
+	if (__tgcompat_glibc_stat (semid, &metadata) != 0)
+	  return -1;
+	memset (arg.buf, 0, sizeof (*arg.buf));
+	arg.buf->sem_perm.__key = metadata.key;
+	arg.buf->sem_perm.uid = metadata.uid;
+	arg.buf->sem_perm.gid = metadata.gid;
+	arg.buf->sem_perm.cuid = metadata.cuid;
+	arg.buf->sem_perm.cgid = metadata.cgid;
+	arg.buf->sem_perm.mode = metadata.mode;
+	arg.buf->sem_perm.__seq = metadata.sequence;
+#if __IPC_TIME64
+	arg.buf->sem_otime = metadata.otime;
+	arg.buf->sem_otime_high = (uint64_t) metadata.otime >> 32;
+	arg.buf->sem_ctime = metadata.ctime;
+	arg.buf->sem_ctime_high = (uint64_t) metadata.ctime >> 32;
+#else
+	arg.buf->sem_otime = metadata.otime;
+	arg.buf->sem_ctime = metadata.ctime;
+#endif
+	arg.buf->sem_nsems = metadata.nsems;
+	return 0;
+      }
+    case SEM_STAT:
+    case SEM_STAT_ANY:
+      {
+        if (arg.buf == NULL)
+          {
+            __set_errno (EFAULT);
+            return -1;
+          }
+        struct tgc_sem_metadata metadata;
+        int result = __tgcompat_glibc_stat_index (semid, &metadata);
+        if (result < 0)
+          return result;
+        memset (arg.buf, 0, sizeof (*arg.buf));
+        arg.buf->sem_perm.__key = metadata.key;
+        arg.buf->sem_perm.uid = metadata.uid;
+        arg.buf->sem_perm.gid = metadata.gid;
+        arg.buf->sem_perm.cuid = metadata.cuid;
+        arg.buf->sem_perm.cgid = metadata.cgid;
+        arg.buf->sem_perm.mode = metadata.mode;
+        arg.buf->sem_perm.__seq = metadata.sequence;
+#if __IPC_TIME64
+        arg.buf->sem_otime = metadata.otime;
+        arg.buf->sem_otime_high = (uint64_t) metadata.otime >> 32;
+        arg.buf->sem_ctime = metadata.ctime;
+        arg.buf->sem_ctime_high = (uint64_t) metadata.ctime >> 32;
+#else
+        arg.buf->sem_otime = metadata.otime;
+        arg.buf->sem_ctime = metadata.ctime;
+#endif
+        arg.buf->sem_nsems = metadata.nsems;
+        return result;
+      }
+    case IPC_INFO:
+    case SEM_INFO:
+      {
+	if (arg.__buf == NULL)
+	  {
+	    __set_errno (EFAULT);
+	    return -1;
+	  }
+	struct tgc_sem_info info;
+	int result = __tgcompat_glibc_info (cmd == SEM_INFO, &info);
+	if (result < 0)
+	  return result;
+	*arg.__buf = (struct seminfo) {
+	  .semmap = info.semmap,
+	  .semmni = info.semmni,
+	  .semmns = info.semmns,
+	  .semmnu = info.semmnu,
+	  .semmsl = info.semmsl,
+	  .semopm = info.semopm,
+	  .semume = info.semume,
+	  .semusz = info.semusz,
+	  .semvmx = info.semvmx,
+	  .semaem = info.semaem,
+	};
+	return result;
+      }
+    default:
+      __set_errno (EINVAL);
+      return -1;
+    }
 }
 
 /* POSIX states ipc_perm mode should have type of mode_t.  */
